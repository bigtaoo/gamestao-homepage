{
  // Static hosting (Cloudflare Workers static assets) for the gamestao studio
  // site. Same Cloudflare account and gamestao.com zone as the three game
  // clients — mirrors the pattern in funny's design/product/deploy-cloudflare.md.
  //
  // Build (outputs dist/, 44 prerendered pages + 404.html + sitemap.xml):
  //   npm run build
  // Deploy (from repo root, reads this file):
  //   npx wrangler deploy -c wrangler/site.jsonc
  //
  // routes[].custom_domain=true auto-provisions DNS + edge cert on first deploy.
  "name": "gamestao-site",
  "compatibility_date": "2026-09-02",

  "assets": {
    "directory": "../dist",

    // NOT "single-page-application", which is what the three game clients use.
    // This site is 44 separate documents, not an SPA: SPA handling would serve
    // the English home page with a 200 for every mistyped URL, which is a soft
    // 404 on every wrong path and real damage to how the site is indexed.
    // "404-page" serves dist/404.html with an actual 404 status.
    "not_found_handling": "404-page",

    // Serves /de/ from /de/index.html and redirects /de/index.html back to
    // /de/, so each page has exactly one URL rather than two that both work
    // and split its ranking.
    "html_handling": "auto-trailing-slash"
  },

  "routes": [
    // The apex is the point of this site: ORIGIN in src/lib/routes.ts is
    // https://gamestao.com, and that one constant is baked into 44 canonical
    // tags, every hreflang alternate, the sitemap and robots.txt. Serving it
    // anywhere else would have every page name a canonical URL that resolves
    // to something other than itself.
    { "pattern": "gamestao.com", "custom_domain": true },
    { "pattern": "www.gamestao.com", "custom_domain": true },

    // Kept as a staging alias. It was the first deploy target while the apex
    // was still GitHub Pages, and it stays useful for exactly that: somewhere
    // to look at a build without touching what visitors hit. Note its pages
    // still declare the apex as canonical, which is the correct behaviour for
    // a staging host - crawlers are pointed away from it.
    { "pattern": "studio.gamestao.com", "custom_domain": true }

    // Prerequisite, checked on 2026-09-03 before this was uncommented: the four
    // GitHub Pages A records on gamestao.com and the www CNAME are gone. An
    // existing record on either hostname is a conflict that fails the WHOLE
    // deploy, not just that route. Cloudflare writes its own proxied record for
    // each custom domain - never hand-add one.
  ]
}
