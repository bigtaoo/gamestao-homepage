{
  // Static hosting (Cloudflare Workers static assets) for the gamestao studio
  // site. Same Cloudflare account and gamestao.com zone as the three game
  // clients — mirrors the pattern in funny's design/product/deploy-cloudflare.md.
  //
  // Build (outputs dist/, 44 prerendered pages + 404.html + sitemap.xml):
  //   npm run build
  // Deploy (from repo root, reads this file):
  //   npx wrangler deploy -c wrangler/site.jsonc
  //
  // routes[].custom_domain=true auto-provisions DNS + edge cert on first deploy.
  "name": "gamestao-site",
  "compatibility_date": "2026-09-02",

  "assets": {
    "directory": "../dist",

    // NOT "single-page-application", which is what the three game clients use.
    // This site is 44 separate documents, not an SPA: SPA handling would serve
    // the English home page with a 200 for every mistyped URL, which is a soft
    // 404 on every wrong path and real damage to how the site is indexed.
    // "404-page" serves dist/404.html with an actual 404 status.
    "not_found_handling": "404-page",

    // Serves /de/ from /de/index.html and redirects /de/index.html back to
    // /de/, so each page has exactly one URL rather than two that both work
    // and split its ranking.
    "html_handling": "auto-trailing-slash"
  },

  "routes": [
    // The apex is the point of this site: ORIGIN in src/lib/routes.ts is
    // https://gamestao.com, and that one constant is baked into 44 canonical
    // tags, every hreflang alternate, the sitemap and robots.txt. Serving it
    // anywhere else would have every page name a canonical URL that resolves
    // to something other than itself.
    { "pattern": "gamestao.com", "custom_domain": true },

    // www serves the site directly here - it does NOT redirect. Under GitHub
    // Pages it 301'd to the apex, which is no longer what happens: a Worker
    // custom domain answers with the content. So every page has two URLs. The
    // canonical tags all name the apex, so crawlers consolidate on it and this
    // is SEO-safe, but a real 301 would be cleaner. The idiomatic way to get
    // one on this zone is a Cloudflare Redirect Rule against a proxied
    // placeholder record - an AAAA pointing at the discard prefix 100::, which
    // is how privacy.gamestao.com and support.gamestao.com worked until both
    // were deleted on 2026-09-15 - which means dropping
    // this route. Deliberately not done in the same change as the takeover:
    // the exact three-step order, and the www outage in the middle of it, are
    // written out in docs/todo.md. Drop the route HERE when the time
    // comes - removing the custom domain from the dashboard while this
    // line survives makes the next deploy re-create it, hit the placeholder
    // record, and fail with code 100117, taking the apex with it.
    { "pattern": "www.gamestao.com", "custom_domain": true }

    // Cloudflare writes its own proxied record for each custom domain, so never
    // hand-add an A or CNAME for these hostnames: an existing record on a
    // hostname is a conflict that fails the WHOLE deploy, not just that route.
    // That is exactly what happened on 2026-09-03 when the apex routes went in
    // before the old GitHub Pages A records were deleted.
    //
    // studio.gamestao.com used to be here as the safe first deploy target while
    // the apex was still GitHub Pages. Removed once the apex was serving: it was
    // never a staging environment, since one deploy updates every hostname on
    // this Worker at the same version.
  ]
}
